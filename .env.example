# Copy this file to .env and fill in your values.

# DATABASE
DATABASE_URL=postgresql+psycopg://postgres:12345@localhost:5432/cortex_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# LLM
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=sk-YOUR_KEY_HERE

# EXTERNAL SERVICES
IRIS_API_BASE_URL=http://localhost:8000
IRIS_API_KEY=iris-key
CELL_API_BASE_URL=http://localhost:8002
CELL_API_KEY=cell-key
ERP_API_BASE_URL=https://erp.internal
ERP_API_KEY=erp-key
INTRANET_API_BASE_URL=https://intranet.internal/api
INTRANET_API_KEY=intranet-key

# SLACK
SLACK_BOT_TOKEN=xoxb-YOUR_TOKEN
SLACK_SIGNING_SECRET=YOUR_SECRET

# CORTEX SERVICE
CORTEX_HOST=0.0.0.0
CORTEX_PORT=8004
CORTEX_API_KEY=my-local-secret
CORTEX_ENV=development

# TIMEZONE
TZ=Asia/Kolkata

# HEALTH SCORE THRESHOLDS
HEALTH_SCORE_RED_THRESHOLD=60
HEALTH_SCORE_AMBER_THRESHOLD=80
BLOCKER_ALERT_DAYS=2
SENTIMENT_DECLINE_WINDOW=3
CADENCE_GAP_DAYS_CLIENT=14
RENEWAL_SIGNAL_WEEKS=6

# SCHEDULED JOBS (IST)
HEALTH_SCAN_TIME=08:00
HEALTH_SCAN_DAY=monday
WEEKLY_PLAN_TIME=07:30
CADENCE_CHECK_TIME=08:00
RENEWAL_CHECK_TIME=08:00
